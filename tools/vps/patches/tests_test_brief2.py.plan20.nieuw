      and oud['secties'][0]['inhoud'].startswith('<p>') and 'Dan stopt de uitkering.' in oud['secties'][0]['inhoud'])
check('tekst is geëscapet (geen tags, & wordt &amp;)', '<b>' not in oud['secties'][0]['inhoud'] and '&amp;' in oud['secties'][0]['inhoud'])
