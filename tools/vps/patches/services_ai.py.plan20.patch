-def analyseer_brief(brief_tekst: str, taal: str = 'nl', extra_context: str = '') -> dict:
-    """
-    Analyseer een brief en geef een gestructureerde uitleg terug.
-
-    Verwerkingsstrategie:
-      1. PII wordt lokaal geredacteerd (BSN, IBAN, adres, kenmerken)
-      2. Geredacteerde tekst wordt naar Claude API (Haiku) gestuurd
-
-    Persoonsgegevens verlaten het systeem nooit — alleen de inhoud
-    van de brief (tekst, deadlines, instructies) wordt verwerkt.
-    """
-    from services.redacteer import redacteer_pii
-
-    # Stap 1: PII lokaal verwijderen
-    geredacteerde_tekst = redacteer_pii(brief_tekst)
-    logger.info(f'PII-redactie klaar: {len(brief_tekst)}→{len(geredacteerde_tekst)} tekens')
-
-    # Testhaak (PLAN-1 fase 3.6): alléén als SOLIDARI_DEBUG_REDACTIE exact '1' is, schrijf de
-    # geredigeerde tekst naar /tmp zodat de redactietest hem kan controleren. Nooit in de unit zetten.
-    import os
-    if os.getenv('SOLIDARI_DEBUG_REDACTIE') == '1':
-        with open('/tmp/redactie-test.txt', 'w', encoding='utf-8') as f:
-            f.write(geredacteerde_tekst)
-
-    prompt = _maak_prompt(geredacteerde_tekst, taal, extra_context)
-
-    # Stap 2: analyse via Claude API
-    try:
-        logger.info('Analyse via Claude API...')
-        resultaat = _via_claude(prompt, _systeem_prompt(taal))
-
-        if resultaat:
-            resultaat = _saniteer_resultaat(resultaat)
-            if _valideer_resultaat(resultaat):
-                resultaat = _vervang_sectietitels(resultaat, taal)
-                logger.info('AI-analyse succesvol')
-                return resultaat
-
-        logger.warning('Claude API: onvolledige output')
-
-    except DagplafondBereikt:
-        # Bewust dóórlaten: dit is geen storing maar een bewuste rem, en de route
-        # moet er een eigen, begrijpelijke melding bij kunnen geven.
-        raise
-    except Exception as e:
-        logger.error(f'Claude API mislukt: {e}')
-
-    raise RuntimeError('De brief kon niet worden geanalyseerd. Probeer het later opnieuw.')
-
