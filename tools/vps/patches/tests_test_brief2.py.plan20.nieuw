r = uitleg(deadline={'datum': '10 listopada 2026', 'citaat': 'U had al stukken moeten sturen vóór 10 november 2026.'})
check('… en "verlopen" werkt dan ook', r['urgentie']['niveau'] == 'verlopen')
r = uitleg(deadline={'datum': None, 'citaat': 'Bezwaar maken kan binnen zes weken na de datum van deze brief.'})
check('alleen een termijn: datum null, citaat blijft', r['deadline'] == {
    'datum': None, 'citaat': 'Bezwaar maken kan binnen zes weken na de datum van deze brief.'})
r = uitleg(deadline={'datum': '28 december 2026', 'citaat': 'Bezwaar maken kan binnen zes weken na de datum van deze brief.'})
check('termijn waar het model zelf een datum bij rekent: datum null, citaat blijft, niet "onzeker"',
      r['deadline'] and r['deadline']['datum'] is None and r['twijfel_code'] is None)
antwoorden[:] = [dict(copy.deepcopy(BASIS), deadline={'datum': '7 dagen na 16 november 2026', 'citaat': 'Vul het formulier binnen 7 dagen na de datum van deze brief in.'})]
r = ai.analyseer_brief(BRIEF + 'Datum: 16 november 2026\nVul het formulier binnen 7 dagen na de datum van deze brief in.\n', 'nl', '', vandaag=VANDAAG)
check('"7 dagen na 16 november 2026" (gezien in TI): geen datum en niet "verlopen"',
