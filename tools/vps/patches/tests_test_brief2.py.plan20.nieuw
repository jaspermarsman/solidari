twee = 'Betaal in twee termijnen: op 27 november 2026 en op 28 december 2026.'
antwoorden[:] = [dict(copy.deepcopy(BASIS), deadline={'datum': '28 december 2026', 'citaat': twee})]
r = ai.analyseer_brief(BRIEF + twee + '\n', 'nl', '', vandaag=VANDAAG)
check('twee datums in het citaat: die van het model, als hij erbij staat', r['deadline']['datum'] == '28 december 2026')
antwoorden[:] = [dict(copy.deepcopy(BASIS), deadline={'datum': '28 grudnia 2026', 'citaat': twee})]
r = ai.analyseer_brief(BRIEF + twee + '\n', 'nl', '', vandaag=VANDAAG)
