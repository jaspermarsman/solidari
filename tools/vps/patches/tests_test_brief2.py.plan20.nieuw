r = uitleg(deadline={'datum': '26 november 2026', 'citaat': 'Lever de stukken in vóór 26 november 2026.'})
check('deadline in de toekomst: urgentie blijft', r['urgentie']['niveau'] == 'hoog')
antwoorden[:] = [dict(copy.deepcopy(BASIS), deadline={'datum': '17 november 2026', 'citaat': 'x'})]
r = ai.analyseer_brief(BRIEF + 'Reageer uiterlijk 17 november 2026.\n', 'nl', '', vandaag=VANDAAG)
