+        logger.warning('Validatie: urgentie ontbreekt of ongeldig')
+        return None
+    leesbaar = ruw.get('leesbaar', True) is not False
+    wat_staat_er = _tekst(ruw.get('wat_staat_er'))
+    if leesbaar and not wat_staat_er:
