-def _valideer_resultaat(resultaat: dict) -> bool:
-    """
-    Controleer of de JSON-output compleet en bruikbaar is.
-    """
-    if not isinstance(resultaat, dict):
-        return False
-
-    # Urgentie aanwezig en geldig niveau
-    urgentie = resultaat.get('urgentie')
-    if not urgentie or urgentie.get('niveau') not in ('hoog', 'midden', 'laag'):
-        logger.warning('Validatie: urgentie ontbreekt of ongeldig')
-        return False
-
-    # Minimaal één sectie met inhoud
-    secties = resultaat.get('secties', [])
-    if not secties or not any(s.get('inhoud') for s in secties):
-        logger.warning('Validatie: geen secties met inhoud')
-        return False
-
-    # Minimaal één actiepunt
-    actiepunten = resultaat.get('actiepunten', [])
-    if not actiepunten:
-        logger.warning('Validatie: geen actiepunten')
-        return False
-
-    return True
