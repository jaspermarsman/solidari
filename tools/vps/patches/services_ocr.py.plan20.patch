+def _tekst_uit_pdf(bestand_bytes: bytes) -> str:
+    """De tekstlaag van een PDF, met pdftotext (poppler). Leeg als die er niet is of het misgaat."""
+    try:
+        uit = subprocess.run(
+            ['pdftotext', '-layout', '-l', str(MAX_PAGINAS), '-enc', 'UTF-8', '-', '-'],
+            input=bestand_bytes, capture_output=True, timeout=20, check=False)
+    except (OSError, subprocess.SubprocessError) as e:
+        logger.warning('pdftotext mislukt: %s', type(e).__name__)
+        return ''
+    if uit.returncode != 0:
+        return ''
+    # pdftotext zet een form feed tussen pagina's
+    paginas = [p.strip('\n') for p in uit.stdout.decode('utf-8', 'replace').split('\f')]
+    return PAGINA_SCHEIDING.join(p for p in paginas if p.strip())
+
