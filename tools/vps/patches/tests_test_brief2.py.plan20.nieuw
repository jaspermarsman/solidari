"""Tests voor Brief Begrijper v2 (PLAN 20, fase 3 en 4).

Draaien:  python3 tests/test_brief2.py
Zonder netwerk en zonder API: het model en (waar nodig) de OCR zijn vervangen door een stub.
Leest /etc/solidari/.env niet en raakt de productieteller niet aan.

  1. De drie controles na het model (B-7): citaat, deadline in het verleden, niets te doen.
  2. Het oude formaat voor pagina's zonder v=2 (B-8).
  3. Opschonen van het antwoord (geen HTML, hooguit drie acties).
  4. OCR: een PDF met tekstlaag gaat niet door Tesseract (B-4); altijd nld+eng.
  5. De route: meer pagina's, grenzen en foutcodes (B-5, B-9).
"""
import copy
import io
import os
import sys
import tempfile
from datetime import date

TMP = tempfile.mkdtemp(prefix='solidari-brief2-test-')
os.environ['SOLIDARI_LOG_DIR'] = TMP
os.environ['ANTHROPIC_API_KEY'] = 'test-sleutel-geen-echte'
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

import dotenv  # noqa: E402
dotenv.load_dotenv = lambda *a, **k: False  # config.py mag /etc/solidari/.env niet lezen

from PIL import Image  # noqa: E402
from flask import Flask  # noqa: E402
from services import ai, ocr  # noqa: E402
from services.teller import DagplafondBereikt  # noqa: E402
import routes.brief as route  # noqa: E402

fouten = []


def check(naam, voorwaarde):
    print(('  OK   ' if voorwaarde else '  FOUT ') + naam)
    if not voorwaarde:
        fouten.append(naam)


def gooit(fn, fout):
    try:
        fn()
    except fout:
        return True
    except Exception:  # noqa: BLE001
        return False
    return False


VANDAAG = date(2026, 11, 17)
BRIEF = ('Gemeente Hoogeland\n\nGeachte mevrouw,\n\nWij hebben informatie van u nodig.\n'
         'Lever de stukken in vóór 26 november 2026. Dat kan aan de balie.\n'
         'U had al stukken moeten sturen vóór 10 november 2026.\n'
         'Bezwaar maken kan binnen zes weken na de datum van deze brief.\n'
         'Vragen? Bel 14 0570.\n')
BASIS = {
    'leesbaar': True,
    'urgentie': {'niveau': 'hoog', 'titel': 'Lever stukken in', 'tekst': 'Doe dit op tijd.'},
    'wat_staat_er': 'De gemeente wil stukken van je.',
    'wat_doen': ['Lever de stukken in vóór 26 november 2026.'],
    'deadline': {'datum': '26 november 2026', 'citaat': 'Lever de stukken in vóór 26 november 2026.'},
    'als_je_niets_doet': None, 'bezwaar': 'Bezwaar kan binnen zes weken.', 'contact': '14 0570', 'twijfel': None,
}

antwoorden = []
aanroepen = []


def stub_claude(bericht, systeem=None):
    aanroepen.append((bericht, systeem))
    a = antwoorden.pop(0)
    if isinstance(a, Exception):
        raise a
    return a


ai._via_claude = stub_claude


def uitleg(**anders):
    """Laat het model BASIS teruggeven met de gegeven velden anders, en haal het door analyseer_brief."""
    a = copy.deepcopy(BASIS)
    a.update(anders)
    antwoorden[:] = [a]
    return ai.analyseer_brief(BRIEF, 'nl', '', vandaag=VANDAAG)


print('1. Controles na het model (B-7)')
r = uitleg()
check('citaat staat in de brief: deadline blijft', r['deadline'] == BASIS['deadline'] and r['twijfel_code'] is None)
check('antwoord heeft geen veld "leesbaar" meer en wel "afgekapt"', 'leesbaar' not in r and r['afgekapt'] is False)
r = uitleg(deadline={'datum': '26 november 2026', 'citaat': 'LEVER DE STUKKEN IN   voor 26 november 2026'})
check('citaat met andere hoofdletters en witruimte maar ander woord ("voor"): vervalt',
      r['deadline'] is None and r['twijfel_code'] == 'deadline_onzeker')
r = uitleg(deadline={'datum': '26 november 2026', 'citaat': 'lever de stukken in\nVÓÓR  26 november 2026'})
check('citaat met andere hoofdletters, witruimte en leestekens: blijft', r['deadline'] is not None)
r = uitleg(deadline={'datum': '3 december 2026', 'citaat': 'U moet reageren vóór 3 december 2026.'})
check('citaat dat niet in de brief staat: deadline null en twijfel_code deadline_onzeker',
      r['deadline'] is None and r['twijfel_code'] == 'deadline_onzeker')
check('… en de urgentie blijft wat het model zei', r['urgentie']['niveau'] == 'hoog')
r = uitleg(deadline={'datum': '28 november 2026', 'citaat': 'Lever de stukken in vóór 26 november 2026.'})
check('citaat klopt maar het model noemt een andere datum: vervalt',
