[Unit]
Description=Solidari backend (Flask/gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=solidari
Group=solidari
WorkingDirectory=/opt/solidari-backend
EnvironmentFile=/etc/solidari/.env
EnvironmentFile=-/etc/solidari/espeak.conf
Environment=SOLIDARI_LOG_DIR=/var/log/solidari
ExecStart=/opt/solidari-backend/venv/bin/gunicorn \
  --bind 127.0.0.1:5000 --workers 2 --threads 1 \
  --no-control-socket \
  --timeout 120 --graceful-timeout 30 \
  --access-logfile /var/log/solidari/access.log \
  --error-logfile /var/log/solidari/error.log \
  app:app
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/solidari
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=2500M

[Install]
WantedBy=multi-user.target
