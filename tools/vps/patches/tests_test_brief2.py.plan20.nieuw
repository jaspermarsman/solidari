antwoorden[:] = [None, copy.deepcopy(BASIS)]
check('onbruikbaar antwoord: herkansing', ai.analyseer_brief(BRIEF, 'nl', '', vandaag=VANDAAG)['wat_staat_er'] != '')

print('1b. Wat er naar het model gaat')
aanroepen.clear()
uitleg()
bericht, systeem = aanroepen[0]
check('datum van vandaag in de systeemprompt', 'Vandaag is het dinsdag 17 november 2026.' in systeem)
check('geen datumlabels meer in het bericht (B-3)', 'VERVALDATUM' not in bericht and 'BRIEFTDATUM' not in bericht)
