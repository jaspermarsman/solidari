+def reserveer_ai_aanroep() -> int:
+    """Reserveer één AI-aanroep voor vandaag.
+
+    Geeft de nieuwe dagstand terug, of gooit DagplafondBereikt als het plafond
+    al bereikt was. Roep dit aan vlak vóór de betaalde aanroep, niet erna.
+    """
+    vandaag = date.today().isoformat()
+
+    try:
+        aantal = _tel_op_schijf(vandaag)
+    except Exception as fout:                     # noqa: BLE001
+        # Bewust geen stilte meer: als de teller niet werkt, werkt het plafond
+        # ook niet, en dat is precies wat we wilden dichtzetten.
+        logger.error('Tellerbestand onbruikbaar (%s) — noodrem in geheugen actief', fout)
+        aantal = _tel_in_geheugen(vandaag)
+
+    if aantal > _DAGPLAFOND:
+        # Eén keer hard loggen bij het passeren, daarna spaarzaam: bij misbruik
+        # zou elke geweigerde poging anders een ERROR-regel opleveren en het
+        # logbestand vollopen — precies wat een aanvaller graag ziet.
+        if aantal == _DAGPLAFOND + 1:
+            logger.error(
+                'DAGPLAFOND BEREIKT: %d aanroepen vandaag, plafond %d — verdere aanvragen worden geweigerd',
+                aantal, _DAGPLAFOND)
+        elif aantal % 100 == 0:
+            logger.warning('Dagplafond nog steeds bereikt: %d pogingen vandaag', aantal)
+        raise DagplafondBereikt(aantal, _DAGPLAFOND)
+
+    if aantal == _DREMPEL + 1:
+        logger.warning(
+            'WAARSCHUWING: %d AI-aanroepen vandaag — drempel %d gepasseerd (plafond %d)',
+            aantal, _DREMPEL, _DAGPLAFOND)
+    elif aantal % 50 == 0:
+        logger.info('AI-aanroepen vandaag: %d van maximaal %d', aantal, _DAGPLAFOND)
+
+    return aantal
