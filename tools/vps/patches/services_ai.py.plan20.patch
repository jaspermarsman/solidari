-def _saniteer_resultaat(resultaat: dict) -> dict:
-    """
-    Herstel veelvoorkomende modelfouten in de JSON-output:
-    - sectie.inhoud is een array of object in plaats van een HTML-string
-    - actiepunten bevat objecten in plaats van strings
-    """
-    for sectie in resultaat.get('secties', []):
-        inhoud = sectie.get('inhoud', '')
-        if isinstance(inhoud, list):
-            delen = []
-            for item in inhoud:
-                if isinstance(item, str):
-                    delen.append(f'<p>{item}</p>')
-                elif isinstance(item, dict):
-                    actie = item.get('actie') or item.get('tekst') or item.get('text') or item.get('inhoud') or ''
-                    deadline = item.get('deadline') or ''
-                    if actie and deadline:
-                        tekst = f'{actie} (vóór {deadline})'
-                    elif actie:
-                        tekst = actie
-                    else:
-                        tekst = str(item)
-                    delen.append(f'<p>{tekst}</p>')
-            sectie['inhoud'] = ''.join(delen)
-            logger.warning('Sectie inhoud was array, omgezet naar HTML')
-        elif isinstance(inhoud, dict):
-            tekst = inhoud.get('tekst') or inhoud.get('text') or str(inhoud)
-            sectie['inhoud'] = f'<p>{tekst}</p>'
-            logger.warning('Sectie inhoud was object, omgezet naar HTML')
-
-    actiepunten = resultaat.get('actiepunten', [])
-    schone_ap = []
-    for ap in actiepunten:
-        if isinstance(ap, str) and ap.strip().startswith("{'"):
-            # String die eruitziet als dict — probeer te parsen via ast
-            import ast
-            try:
-                ap = ast.literal_eval(ap.strip())
-            except Exception:
-                schone_ap.append(ap)
-                continue
-        if isinstance(ap, str):
-            schone_ap.append(ap)
-        elif isinstance(ap, dict):
-            # Model geeft soms {"deadline": "...", "actie": "..."} terug
-            actie = ap.get('actie') or ap.get('tekst') or ap.get('text') or ''
-            deadline = ap.get('deadline') or ''
-            if actie and deadline:
-                schone_ap.append(f'{actie} (vóór {deadline})')
-            elif actie:
-                schone_ap.append(actie)
-            else:
-                schone_ap.append(str(ap))
-            logger.warning('Actiepunt was object, omgezet naar string')
-    resultaat['actiepunten'] = schone_ap
-
-    # Sectie-inhoud: als het een string is maar eruitziet als dict-representatie, opruimen
-    for sectie in resultaat.get('secties', []):
-        inhoud = sectie.get('inhoud', '')
-        if isinstance(inhoud, str) and inhoud.strip().startswith("{'"):
-            # Ruwe dict als string — vervang door lege melding
-            sectie['inhoud'] = '<p>Zie de actiepunten hieronder.</p>'
-            logger.warning('Sectie inhoud was dict-string, vervangen')
-
-    return resultaat
