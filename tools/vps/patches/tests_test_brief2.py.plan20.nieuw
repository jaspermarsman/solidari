check('actiepunten = wat_doen', oud['actiepunten'] == r['wat_doen'])
check('elke sectie heeft icoon, titel, achtergrond (#rrggbb) en inhoud',
      all(set(s) == {'icoon', 'titel', 'achtergrond', 'inhoud'} and len(s['achtergrond']) == 7 for s in oud['secties']))
r = uitleg(deadline={'datum': '10 november 2026', 'citaat': 'U had al stukken moeten sturen vóór 10 november 2026.'})
