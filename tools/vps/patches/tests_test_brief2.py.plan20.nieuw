oud = ai.naar_oud_formaat(r, 'xx')
check('zonder actie: lege lijst, één sectie, Nederlandse titel bij onbekende taal',
      oud['actiepunten'] == [] and len(oud['secties']) == 1 and oud['secties'][0]['titel'] == 'Wat staat er in deze brief?')

print('3. Opschonen van het antwoord')
r = uitleg(wat_staat_er='<p>De <strong>gemeente</strong> wil stukken.</p>', wat_doen=['a', 'b', 'c', 'd', {'x': 1}, ''],
           deadline=None, twijfel='null', contact='  ')
check('HTML-tags uit de tekst', r['wat_staat_er'] == 'De gemeente wil stukken.')
check('hooguit drie acties, alleen tekst', r['wat_doen'] == ['a', 'b', 'c'])
check('"null" en lege tekst worden None', r['twijfel'] is None and r['contact'] is None)
antwoorden[:] = [{'urgentie': {'niveau': 'paars'}, 'wat_staat_er': 'x'}, 'geen dict']
check('ongeldige urgentie en geen object: fout na twee pogingen',
      gooit(lambda: ai.analyseer_brief(BRIEF, 'nl', '', vandaag=VANDAAG), RuntimeError))

print('4. OCR (B-4)')
ocr_aanroepen = []
echte_ocr = ocr.pytesseract.image_to_string


def stub_tesseract(afbeelding, lang=None, config=None):
    ocr_aanroepen.append((lang, config))
    return 'Tekst uit de foto van de brief, lang genoeg.'


ocr.pytesseract.image_to_string = stub_tesseract
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', '..', 'Solidari-brief2', 'tools', 'test', 'nepbrieven'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'tools', 'test', 'nepbrieven'))
try:
    import maak_beeld
    from pathlib import Path
    pdf_pad = Path(TMP) / 'tekst.pdf'
    maak_beeld.naar_pdf(BRIEF * 3, pdf_pad)
    tekst = ocr.lees_tekst_uit_bestand(pdf_pad.read_bytes(), 'application/pdf')
    check('tekst-PDF: direct gelezen, geen OCR-aanroep', 'Gemeente Hoogeland' in tekst and '26 november 2026' in tekst
          and ocr_aanroepen == [])
    maak_beeld.naar_pdf('kort', pdf_pad)
    ocr.lees_tekst_uit_bestand(pdf_pad.read_bytes(), 'application/pdf')
