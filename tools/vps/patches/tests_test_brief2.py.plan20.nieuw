print('2. Oud formaat zonder v=2 (B-8)')
r = uitleg(wat_staat_er='Tekst met <b>haakjes</b> & een teken.', als_je_niets_doet='Dan stopt de uitkering.')
oud = ai.naar_oud_formaat(r, 'pl')
check('velden van het oude formaat', set(oud) == {'urgentie', 'secties', 'actiepunten'})
