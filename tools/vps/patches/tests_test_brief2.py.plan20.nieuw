antwoorden[:] = [dict(copy.deepcopy(BASIS), deadline={'datum': '17 november 2026', 'citaat': 'Reageer uiterlijk 17 november 2026.'})]
r = ai.analyseer_brief(BRIEF + 'Reageer uiterlijk 17 november 2026.\n', 'nl', '', vandaag=VANDAAG)
check('deadline vandaag is niet verlopen', r['urgentie']['niveau'] == 'hoog')

