except ImportError:
    print('  (overgeslagen: maak_beeld.py niet gevonden; de PDF-test heeft tools/test/nepbrieven nodig)')


def jpeg(exif_stand=None):
    img = Image.new('RGB', (300, 200), 'white')
    buf = io.BytesIO()
    if exif_stand:
        exif = img.getexif()
        exif[0x0112] = exif_stand
        img.save(buf, 'JPEG', exif=exif)
    else:
        img.save(buf, 'JPEG')
    return buf.getvalue()


ocr_aanroepen.clear()
ocr.lees_tekst_uit_bestand(jpeg(), 'image/jpeg', 'ar')
check('foto: altijd nld+eng, ook als de gebruiker Arabisch kiest', ocr_aanroepen[0][0] == 'nld+eng')
check('psm uit de instelling', f'--psm {ocr.OCR_PSM}' in ocr_aanroepen[0][1])
gezien = []
echte_verbeter = ocr._verbeter_afbeelding
ocr._verbeter_afbeelding = lambda a: (gezien.append(a.size), echte_verbeter(a))[1]
ocr.lees_tekst_uit_bestand(jpeg(6), 'image/jpeg')      # 6 = een kwartslag gedraaid
check('EXIF-stand: de foto wordt rechtgezet vóór de OCR', gezien[-1] == (200, 300))
ocr._verbeter_afbeelding = echte_verbeter
ocr_aanroepen.clear()
tekst = ocr.lees_tekst_uit_bestanden([(jpeg(), 'image/jpeg')] * 3)
check('drie foto\'s: drie keer OCR, met een paginascheiding ertussen',
      len(ocr_aanroepen) == 3 and tekst.count('NIEUWE PAGINA') == 2)

print('5. De route: meer pagina\'s, grenzen en foutcodes (B-5, B-9)')
app = Flask(__name__)
app.register_blueprint(route.brief_bp, url_prefix='/api')
c = app.test_client()
gelezen = {}


def stub_analyse(tekst, taal='nl', context='', vandaag=None):
    gelezen.update(tekst=tekst, taal=taal, context=context)
    if stub_analyse.fout:
        raise stub_analyse.fout
    a = ai._normaliseer(copy.deepcopy(BASIS))
    a.pop('leesbaar')
    a['afgekapt'] = False
    return a


stub_analyse.fout = None
route.analyseer_brief = stub_analyse


def post(bestanden, **velden):
    data = dict(velden)
    data['brief'] = [(io.BytesIO(inhoud), naam, ctype) for inhoud, naam, ctype in bestanden]
    return c.post('/api/analyseer', data=data, content_type='multipart/form-data')


FOTO = (jpeg(), 'brief.jpg', 'image/jpeg')
r = c.post('/api/analyseer', data={'taal': 'nl'})
check('geen bestand → 400 geen_bestand', r.status_code == 400 and r.json['code'] == 'geen_bestand' and r.json['fout'])
r = post([(b'abc', 'brief.docx', 'application/msword')])
check('verkeerd type → 415 type', r.status_code == 415 and r.json['code'] == 'type')
r = post([FOTO, (b'%PDF-1.4', 'brief.pdf', 'application/pdf')])
check('PDF samen met een foto → 415 type', r.status_code == 415 and r.json['code'] == 'type')
r = post([FOTO] * 5)
check('vijf foto\'s → 413 te_groot', r.status_code == 413 and r.json['code'] == 'te_groot')
groot = (b'\xff\xd8' + b'0' * (6 * 1024 * 1024), 'groot.jpg', 'image/jpeg')
r = post([groot, groot])
check('samen meer dan 10 MB → 413 te_groot', r.status_code == 413 and r.json['code'] == 'te_groot')
ocr_aanroepen.clear()
r = post([FOTO] * 4, taal='PL', context='van de gemeente', v='2')
check('vier foto\'s met v=2 → 200 in het nieuwe formaat', r.status_code == 200 and 'wat_staat_er' in r.json
      and 'secties' not in r.json and len(ocr_aanroepen) == 4)
check('taal en context komen door', gelezen['taal'] == 'pl' and gelezen['context'] == 'van de gemeente')
r = post([FOTO], taal='nl')
check('zonder v → 200 in het oude formaat', r.status_code == 200 and set(r.json) == {'urgentie', 'secties', 'actiepunten'})
r = post([FOTO], taal='zz', v='2')
check('onbekende taal wordt nl', r.status_code == 200 and gelezen['taal'] == 'nl')
ocr.pytesseract.image_to_string = lambda *a, **k: '  \n '
r = post([FOTO], v='2')
check('geen tekst → 422 geen_tekst', r.status_code == 422 and r.json['code'] == 'geen_tekst')


def kapot(*a, **k):
    raise OSError('kan het beeld niet lezen')


ocr.pytesseract.image_to_string = kapot
r = post([FOTO], v='2')
check('OCR-fout → 422 onleesbaar', r.status_code == 422 and r.json['code'] == 'onleesbaar')
r = post([(b'geen plaatje', 'brief.jpg', 'image/jpeg')], v='2')
check('kapot bestand → 422 onleesbaar', r.status_code == 422 and r.json['code'] == 'onleesbaar')
ocr.pytesseract.image_to_string = stub_tesseract
stub_analyse.fout = ai.BriefOnleesbaar('x')
r = post([FOTO], v='2')
check('model zegt onleesbaar → 422 onleesbaar', r.status_code == 422 and r.json['code'] == 'onleesbaar')
stub_analyse.fout = DagplafondBereikt(501, 500)
r = post([FOTO], v='2')
check('dagplafond → 429 dagplafond', r.status_code == 429 and r.json['code'] == 'dagplafond')
stub_analyse.fout = RuntimeError('x')
r = post([FOTO], v='2')
check('storing → 500 storing, met de Nederlandse zin voor oude pagina\'s',
      r.status_code == 500 and r.json['code'] == 'storing' and 'later opnieuw' in r.json['fout'])
ocr.pytesseract.image_to_string = echte_ocr

print()
if fouten:
    print(f'{len(fouten)} test(s) mislukt:', ', '.join(fouten))
    sys.exit(1)
print('Alle tests geslaagd.')
