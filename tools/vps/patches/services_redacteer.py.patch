+# ── Naamredactie (v1.1) ───────────────────────────────────────────────────────
+
+def _naam_uit_adresblok(tekst: str) -> list[str]:
+    """Eerste niet-lege regel van het gelabelde adresblok is (vrijwel altijd) de naam.
+    Geeft varianten terug: de hele regel en de achternaam (laatste woord ≥ 4 letters)."""
+    m = ONTVANGERADRES_BLOK.search(tekst)
+    if not m:
+        return []
+    blok = m.group(0).split(':', 1)[-1].rstrip(']')
+    regels = [r.strip() for r in blok.splitlines() if r.strip()]
+    if not regels:
+        return []
+    naamregel = regels[0]
+    # Geen straat/postcode als naam aanzien
+    if re.search(r'\d', naamregel):
+        return []
+    varianten = [naamregel]
+    woorden = [w for w in re.split(r'[\s.]+', naamregel) if len(w) >= 4]
+    if woorden:
+        varianten.append(woorden[-1])
+    return varianten
+
+
+def _redacteer_naam(tekst: str, varianten: list[str]) -> tuple[str, int]:
+    n = 0
+    # a) aanhefregel: naam na "Geachte heer/mevrouw" altijd weg, ook zonder adresblok
+    def aanhef_sub(m):
+        nonlocal n
+        n += 1
+        return f'{m.group(1)}[NAAM],'
+    tekst = AANHEF.sub(aanhef_sub, tekst)
+    # b) naamvarianten uit het adresblok, overal in de tekst (hoofdletterongevoelig, hele woorden)
+    for v in varianten:
+        pat = re.compile(r'(?<![\w])' + re.escape(v) + r'(?![\w])', re.IGNORECASE)
+        tekst, k = pat.subn('[NAAM]', tekst)
+        n += k
+    if n:
+        logger.debug(f'Redacteer naam: {n} match(es)')
+    return tekst, n
